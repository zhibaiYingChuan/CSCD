{
  "mcpServers": {
    "cscd-protocol": {
      "command": "python",
      "args": ["cscd_mcp_server.py"],
      "cwd": "${workspaceFolder}",
      "env": {
        "LLM_API_URL": "https://your-endpoint",
        "LLM_API_KEY": "${env:LLM_API_KEY}",
        "LLM_MODEL": "your-model-name"
      }
    }
  }
}
